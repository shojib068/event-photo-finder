# Copy to .env and fill in. Never commit .env. Only src/core/config reads these.

# --- Database (Postgres 16 + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgres://wedding:wedding@localhost:5432/wedding

# --- Google Drive (service account = "the app's email address") ---
# Path to the service account JSON key (keep it in ./secrets/, which is gitignored).
# Share every Drive folder with the service account's client_email (shown on the admin page).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json

# --- Face recognition ---
FACE_PROVIDER=insightface
FACE_SERVICE_URL=http://127.0.0.1:8001
# Cosine similarity cut-off (spec: "about 90%" precision; ArcFace same-person cosine is ~0.4-0.8).
MATCH_THRESHOLD=0.45

# --- Public URL / tunnel ---
# HTTPS tunnel URL printed in the QR codes. Set it BEFORE downloading QR codes.
# e.g. run: cloudflared tunnel --url http://localhost:3000
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_TUNNEL_HOST
# Set to "cloudflared" or "ngrok" to have `npm run local` start a tunnel; empty = no tunnel.
# cloudflared quick tunnels get a NEW random URL every run (old QR codes stop working).
# For a permanent URL use ngrok + NGROK_DOMAIN (one free static domain per ngrok account).
TUNNEL=
# Your free ngrok static domain, e.g. something.ngrok-free.app (only used when TUNNEL=ngrok).
NGROK_DOMAIN=

# --- Admin page path secret (no login by spec): /admin/<ADMIN_PATH_SECRET> ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PATH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# --- Limits and worker ---
MAX_SELFIE_BYTES=5242880
WORKER_CONCURRENCY=2
# Gallery tokens and event slugs: 128-bit random, base64url (fixed by spec, not configurable).

# --- Misc ---
THUMB_CACHE_DIR=./.cache/thumbs
LOG_LEVEL=info
PORT=3000
