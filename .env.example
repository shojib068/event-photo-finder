# Copy to .env and fill in. Never commit .env.
# Only the developer machine needs these (indexing, QR codes, local dev photo proxy).
# In Cloudflare Pages set GOOGLE_SERVICE_ACCOUNT_JSON and PHOTO_REF_SECRET as encrypted
# environment variables (Settings -> Environment variables -> Production).

# --- Google Drive service account (read-only) ---
# Share every event's Drive folder with the service account's client_email (Viewer).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json

# --- Photo reference secret ---
# Encrypts Drive file IDs inside the public face indexes. MUST be identical locally and on
# Cloudflare Pages, and must not change after indexing (otherwise re-run `npm run index`).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PHOTO_REF_SECRET=

# --- Production URL printed into QR codes (https, permanent, no localhost) ---
SITE_URL=https://yourwebsite.pages.dev

# --- Browser settings (baked in at build time; also set in Cloudflare Pages build env) ---
# Similarity (0..1) a face must reach to count as a match.
# Higher = fewer look-alikes but more missed photos. Measured: same person 0.52-0.99, others up to ~0.78.
VITE_MATCH_THRESHOLD=0.6
